{
  "name": "@agate/wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "agate's wallets on Dynamic + ZeroDev: the main smart account, the AI pocket and its session key, and the one list of calls a pocket may make. Shared by the app (browser) and the server.",
