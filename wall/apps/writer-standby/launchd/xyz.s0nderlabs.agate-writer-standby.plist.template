<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  agate standby writer for one index, as a launchd agent. TEMPLATE: nothing installs or loads it; make one copy per
  index (Label and log paths carry __INDEX8__ = the index address's first 8 hex digits after 0x, lowercase; a second
  index needs its own Label, 13.7).
  launchd jobs hang on files under ~/Documents (macOS privacy prompt), so the job runs a copy of wall/ outside it
  (__APP__, e.g. ~/.agate-wall/app/wall) and keeps its data in AGATE_WALL_HOME (~/.agate-wall).
  No key in this file: run-standby.sh asks AGATE_STANDBY_KEY_CMD for it at start (a command the operator chooses).
  RPC (13.6): __RPC_URLS_CMD__ is a command the process runs once at start to print its URL list. Since Oct 4 Alchemy
  serves the light roles only (ops/testnet/RUNBOOK.md, "Alchemy"; an all-Alchemy list spent 11.3M compute units in 7
  hours that day): the writer's own transactions go to Alchemy first as a send: entry, every read to the key-free
  public RPCs. The process meters its Alchemy calls against AGATE_ALCHEMY_DAILY_CU (default 400,000 a UTC day). It
  holds no secret itself; the Alchemy key is read from Keychain at start, kept in memory and never written anywhere.
  XML-escape it here (& as &amp;):
    k="$(security find-generic-password -s agate.alchemy-api-key -a api-key -w)" &amp;&amp; printf 'send:https://monad-testnet.g.alchemy.com/v2/%s,https://testnet-rpc.monad.xyz,https://10143.rpc.thirdweb.com,https://rpc.ankr.com/monad_testnet' "$k"
  To use: replace __HOME__, __APP__, __BUN__, __RPC_URLS_CMD__, __CHAIN_ID__ (10143 on Monad testnet), __INDEX__,
  __INDEX8__, __PANELS__ (wall/packages/sources/panels/launch.json for the launch indexes, 7.10), __KEY_CMD__; copy
  to ~/Library/LaunchAgents/; then `launchctl bootstrap gui/$(id -u) <plist>`.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>xyz.s0nderlabs.agate-writer-standby-__INDEX8__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__APP__/apps/writer-standby/launchd/run-standby.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__APP__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BUN</key>
    <string>__BUN__</string>
    <key>AGATE_RPC_URLS_CMD</key>
    <string>__RPC_URLS_CMD__</string>
    <key>AGATE_CHAIN_ID</key>
    <string>__CHAIN_ID__</string>
    <key>AGATE_INDEX</key>
    <string>__INDEX__</string>
    <key>AGATE_PANELS</key>
    <string>__PANELS__</string>
    <key>AGATE_WALL_HOME</key>
    <string>__HOME__/.agate-wall</string>
    <key>AGATE_STANDBY_KEY_CMD</key>
    <string>__KEY_CMD__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.agate-wall/standby/stdout-__INDEX8__.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.agate-wall/standby/stderr-__INDEX8__.log</string>
</dict>
</plist>
