pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {IKuruOrderBook} from "../../../src/market/interfaces/IKuruOrderBook.sol";
import {MockKuruRouter} from "../mocks/MockKuruRouter.sol";
import {KuruRouterBase} from "../mocks/KuruRouterBase.sol";
import {MockKuruOrderBook} from "../mocks/MockKuruOrderBook.sol";
import {NoPermitDollar} from "./RouterTokens.sol";

/// The Kuru V1 stand-in (BUILD-SPEC 6.5, 7, 12.2 C) against the reference model's MockKuruMarket: Kuru's per-level
/// re-derivation of a market buy, fill-or-kill on sells, the unused quote refunded on non-fill-or-kill buys, the
/// taker fee, maker payments, marketState, deployProxy's checks, computeAddress and verifiedMarket.
contract KuruMockTest is Test {
    uint256 internal constant U = 1_000_000;
    uint96 internal constant UNIT = 100; // base units per size unit

    MockKuruRouter internal kuru;
    NoPermitDollar internal base;
    NoPermitDollar internal quote;
    MockKuruOrderBook internal m;
    address internal mm = makeAddr("mm");
    address internal taker = makeAddr("taker");
    address internal stranger = makeAddr("stranger");

    function setUp() public {
        kuru = new MockKuruRouter();
        base = new NoPermitDollar("base", "B");
        quote = new NoPermitDollar("quote", "Q");
        m = _market(0, 0);
    }

    function _market(uint256 tf, uint256 mf) internal returns (MockKuruOrderBook mk) {
        mk = MockKuruOrderBook(
            kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, tf, mf, 30)
        );
        base.mint(mm, 1e16);
        quote.mint(mm, 1e16);
        base.mint(taker, 1e16);
        quote.mint(taker, 1e16);
        vm.startPrank(mm);
        base.approve(address(mk), type(uint256).max);
        quote.approve(address(mk), type(uint256).max);
        vm.stopPrank();
        vm.startPrank(taker);
        base.approve(address(mk), type(uint256).max);
        quote.approve(address(mk), type(uint256).max);
        vm.stopPrank();
    }

    function _ask(MockKuruOrderBook mk, uint32 price, uint256 tokens) internal {
        vm.prank(mm);
        mk.addSellOrder(price, uint96(tokens * U / UNIT), false);
    }

    function _bid(MockKuruOrderBook mk, uint32 price, uint256 tokens) internal {
        vm.prank(mm);
        mk.addBuyOrder(price, uint96(tokens * U / UNIT), false);
    }

    // ------------------------------------------------------------------ deployProxy, computeAddress, verifiedMarket

    function test_deployProxy_addressEqualsComputeAddressAndVerified() public view {
        address predicted = kuru.computeAddress(
            address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 0, 0, 30, address(0), false
        );
        assertEq(predicted, address(m));
        (
            uint32 pp,
            uint96 sp,
            address b,
            uint256 bd,
            address q,
            uint256 qd,
            uint32 tick,
            uint96 mn,
            uint96 mx,
            uint256 tf,
            uint256 mf
        ) = kuru.verifiedMarket(address(m));
        assertEq(
            abi.encode(pp, sp, b, bd, q, qd, tick, mn, mx, tf, mf),
            abi.encode(
                uint32(1e6),
                uint96(10_000),
                address(base),
                uint256(6),
                address(quote),
                uint256(6),
                uint32(10_000),
                uint96(10_000),
                uint96(1e10),
                uint256(0),
                uint256(0)
            )
        );
        {
            (
                uint32 pp2,
                uint96 sp2,
                address b2,
                uint256 bd2,
                address q2,
                uint256 qd2,
                uint32 t2,
                uint96 mn2,
                uint96 mx2,
                uint256 tf2,
                uint256 mf2
            ) = m.getMarketParams();
            assertEq(
                abi.encode(pp2, sp2, b2, bd2, q2, qd2, t2, mn2, mx2, tf2, mf2),
                abi.encode(pp, sp, b, bd, q, qd, tick, mn, mx, tf, mf)
            );
        }
        (pp,, b,,,,,,,,) = kuru.verifiedMarket(stranger);
        assertEq(pp, 0);
        assertEq(b, address(0));
        assertEq(m.marketState(), 0);
        assertEq(m.unit(), UNIT);
        // other parameters, other address
        assertTrue(
            kuru.computeAddress(
                address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 30, 0, 30, address(0), false
            ) != predicted
        );
    }

    function test_deployProxy_checks() public {
        vm.expectRevert(KuruRouterBase.InvalidSpread.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 0, 0, 0);
        vm.expectRevert(KuruRouterBase.InvalidSpread.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 0, 0, 15);
        vm.expectRevert(KuruRouterBase.InvalidSpread.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 0, 0, 500);
        vm.expectRevert(KuruRouterBase.MarketSizeError.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 10_000, 0, 0, 30);
        vm.expectRevert(KuruRouterBase.MarketSizeError.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 0, 1e10, 0, 0, 30);
        vm.expectRevert(KuruRouterBase.MarketFeeError.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 10, 20, 30);
        vm.expectRevert(KuruRouterBase.MarketFeeError.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 10_000, 0, 30);
        vm.expectRevert(KuruRouterBase.InvalidSizePrecision.selector);
        kuru.deployProxy(0, address(base), address(quote), 20_000, 1e6, 10_000, 10_000, 1e10, 0, 0, 30);
        vm.expectRevert(KuruRouterBase.InvalidPricePrecision.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 0, 10_000, 10_000, 1e10, 0, 0, 30);
        vm.expectRevert(KuruRouterBase.InvalidTickSize.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 0, 10_000, 1e10, 0, 0, 30);
        vm.expectRevert(KuruRouterBase.MarketTypeMismatch.selector);
        kuru.deployProxy(1, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 0, 0, 30);
        vm.expectRevert(KuruRouterBase.MarketTypeMismatch.selector);
        kuru.deployProxy(0, address(base), address(base), 10_000, 1e6, 10_000, 10_000, 1e10, 0, 0, 30);
        // the same parameters again: the market exists
        vm.expectRevert(MockKuruRouter.FailedDeployment.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 0, 0, 30);
        // fees 10 / 0 accepted (Appendix C)
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 10, 0, 30);
    }

    function test_closedDeployProxy_onlyOwner() public {
        vm.prank(stranger);
        vm.expectRevert(KuruRouterBase.Unauthorized.selector);
        kuru.setPermissionless(false);
        kuru.setPermissionless(false);
        vm.prank(stranger);
        vm.expectRevert(KuruRouterBase.Unauthorized.selector);
        kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 30, 0, 30);
        address mk = kuru.deployProxy(0, address(base), address(quote), 10_000, 1e6, 10_000, 10_000, 1e10, 30, 0, 30);
        assertGt(mk.code.length, 0);
    }

    // ------------------------------------------------------------------ BUILD-SPEC 6.5: Kuru's market-buy rounding

    function test_multiLevelBuy_losesKuruDust_exactOutNeedsHeadroom() public {
        _ask(m, 3_640_000, 1_000);
        _ask(m, 3_650_000, 1_000);
        _ask(m, 3_700_000, 1_000);
        uint256 exact = 1_000 * 3_640_000 + 100 * 3_650_000; // 4,005,000,000 u
        (uint256 got, uint256 rem) = m.simulateBuy(exact);
        assertEq(got, 1_100 * U - UNIT); // one size unit short
        assertEq(rem, 0);
        (got,) = m.simulateBuy(exact + 3_650_000 / 10_000); // plus one unit's cost at the second level
        assertEq(got, 1_100 * U);
        (got, rem) = m.simulateBuy(1_000 * 3_640_000); // one level: exact
        assertEq(got, 1_000 * U);
        assertEq(rem, 0);
        (bool ok, uint256 qf) = m.quoteFor(1_100 * U);
        assertTrue(ok);
        (got,) = m.simulateBuy(qf);
        assertGe(got, 1_100 * U);
        (got,) = m.simulateBuy(qf - 1);
        assertLt(got, 1_100 * U);
        assertLe(qf, exact + 365);
        // the dust stays in the market, not with the taker
        uint256 q0 = quote.balanceOf(taker);
        uint256 b0 = base.balanceOf(taker);
        vm.prank(taker);
        uint256 out = m.placeAndExecuteMarketBuy(uint96(exact), 1, false, false);
        assertEq(out, 1_100 * U - UNIT);
        assertEq(base.balanceOf(taker) - b0, out);
        assertEq(q0 - quote.balanceOf(taker), exact);
        assertEq(m.depthAt(true, 3_650_000), (900 * U + UNIT) / UNIT);
    }

    /// The integration attacker's fork numbers on Kuru's deployed code (Appendix C): 1,000 at 3.64 and 100 at 3.65,
    /// exact cost plus $10 not fill-or-kill buys exactly 1,100 tokens and refunds 9,999,540 u; fill-or-kill reverts.
    function test_exactDepth_nonFok_refunds_9999540_fokReverts() public {
        _ask(m, 3_640_000, 1_000);
        _ask(m, 3_650_000, 100);
        uint256 exact = 1_000 * 3_640_000 + 100 * 3_650_000;
        vm.prank(taker);
        vm.expectRevert(MockKuruOrderBook.InsufficientLiquidity.selector);
        m.placeAndExecuteMarketBuy(uint96(exact + 10 * U), 1_100 * U, false, true);
        uint256 q0 = quote.balanceOf(taker);
        uint256 mm0 = quote.balanceOf(mm);
        vm.prank(taker);
        uint256 out = m.placeAndExecuteMarketBuy(uint96(exact + 10 * U), 1_100 * U, false, false);
        assertEq(out, 1_100 * U);
        assertEq(q0 - quote.balanceOf(taker), exact + 10 * U - 9_999_540);
        assertEq(quote.balanceOf(mm) - mm0, exact); // makers paid exactly the book's cost
        assertEq(quote.balanceOf(address(m)), 460); // Kuru's dust over two levels
        assertEq(m.levels(true).length, 0);
    }

    /// Kuru's simulation path: a call from address(0) returns what the quote buys, moves nothing, and skips the
    /// fill-or-kill check; the real fill then returns the same.
    function test_simulationFromAddressZero_equalsTheFill() public {
        _ask(m, 3_640_000, 1_000);
        _ask(m, 3_650_000, 100);
        uint256 exact = 1_000 * 3_640_000 + 100 * 3_650_000;
        vm.prank(address(0));
        uint256 sim = m.placeAndExecuteMarketBuy(uint96(exact), 0, false, true);
        assertEq(sim, 1_100 * U - UNIT);
        assertEq(m.depthAt(true, 3_640_000), 1_000 * U / UNIT);
        vm.prank(taker);
        assertEq(m.placeAndExecuteMarketBuy(uint96(exact), 1, false, false), sim);
    }

    function test_sell_isExact_fokRevertsOnShortBook_nonFokReturnsTheRest() public {
        _bid(m, 3_600_000, 1_000);
        _bid(m, 3_550_000, 500);
        vm.prank(taker);
        vm.expectRevert(MockKuruOrderBook.InsufficientLiquidity.selector);
        m.placeAndExecuteMarketSell(uint96(1_501 * U / UNIT), 1, false, true);
        uint256 q0 = quote.balanceOf(taker);
        vm.prank(taker);
        uint256 out = m.placeAndExecuteMarketSell(uint96(1_200 * U / UNIT), 1, false, true);
        assertEq(out, 1_000 * 3_600_000 + 200 * 3_550_000);
        assertEq(quote.balanceOf(taker) - q0, out);
        uint256 b0 = base.balanceOf(taker);
        vm.prank(taker);
        out = m.placeAndExecuteMarketSell(uint96(400 * U / UNIT), 1, false, false); // 300 left on the book
        assertEq(out, 300 * 3_550_000);
        assertEq(b0 - base.balanceOf(taker), 300 * U);
        vm.prank(taker);
        vm.expectRevert(MockKuruOrderBook.SlippageExceeded.selector);
        m.placeAndExecuteMarketSell(uint96(1), 1, false, false); // empty book: 0 out
    }

    function test_takerFee_onBothSides() public {
        MockKuruOrderBook f = _market(30, 10);
        _ask(f, 3_640_000, 100);
        _bid(f, 3_600_000, 100);
        uint256 b0 = base.balanceOf(taker);
        vm.prank(taker);
        uint256 got = f.placeAndExecuteMarketBuy(uint96(364 * U), 1, false, false);
        assertEq(got, 100 * U - 300_000); // 30 bps of the tokens, rounded up, stay in the market
        assertEq(base.balanceOf(taker) - b0, got);
        uint256 q0 = quote.balanceOf(taker);
        vm.prank(taker);
        uint256 out = f.placeAndExecuteMarketSell(uint96(100 * U / UNIT), 1, false, true);
        assertEq(out, 360 * U - 1_080_000);
        assertEq(quote.balanceOf(taker) - q0, out);
    }

    function test_marketState_pauseRevertsEveryOrder() public {
        _ask(m, 3_640_000, 10);
        vm.prank(stranger);
        vm.expectRevert(KuruRouterBase.Unauthorized.selector);
        kuru.setMarketState(address(m), 1);
        vm.expectRevert(MockKuruOrderBook.Unauthorized.selector);
        m.setMarketState(1);
        kuru.setMarketState(address(m), 1);
        assertEq(m.marketState(), 1);
        vm.startPrank(taker);
        vm.expectRevert(MockKuruOrderBook.MarketStateError.selector);
        m.placeAndExecuteMarketBuy(uint96(U), 1, false, false);
        vm.expectRevert(MockKuruOrderBook.MarketStateError.selector);
        m.placeAndExecuteMarketSell(1, 1, false, true);
        vm.expectRevert(MockKuruOrderBook.MarketStateError.selector);
        m.addSellOrder(3_640_000, 10_000, false);
        vm.stopPrank();
        kuru.setMarketState(address(m), 0);
        vm.prank(taker);
        assertEq(m.placeAndExecuteMarketBuy(uint96(3_640_000), 1, false, false), U);
    }

    function test_orderChecks() public {
        vm.startPrank(mm);
        vm.expectRevert(MockKuruOrderBook.TickSizeError.selector);
        m.addSellOrder(3_645_000, 10_000, false);
        vm.expectRevert(MockKuruOrderBook.PriceError.selector);
        m.addSellOrder(0, 10_000, false);
        vm.expectRevert(MockKuruOrderBook.SizeError.selector);
        m.addSellOrder(3_640_000, 9_999, false);
        vm.expectRevert(MockKuruOrderBook.SizeError.selector);
        m.addBuyOrder(3_640_000, 1e10 + 1, false);
        vm.stopPrank();
        vm.startPrank(taker);
        vm.expectRevert(MockKuruOrderBook.ZeroSize.selector);
        m.placeAndExecuteMarketBuy(0, 0, false, false);
        vm.expectRevert(MockKuruOrderBook.MarginUnsupported.selector);
        m.placeAndExecuteMarketBuy(1, 0, true, false);
        vm.deal(taker, 1 ether);
        vm.expectRevert(MockKuruOrderBook.NativeUnsupported.selector);
        m.placeAndExecuteMarketSell{value: 1}(1, 0, false, false);
        vm.stopPrank();
    }

    function test_tradeEvent_andFifo() public {
        _ask(m, 3_640_000, 1); // order 1
        _ask(m, 3_640_000, 2); // order 2, same level, behind it
        vm.expectEmit(address(m));
        emit IKuruOrderBook.Trade(1, mm, true, 3_640_000 * 1e12, 0, taker, tx.origin, uint96(U / UNIT));
        vm.expectEmit(address(m));
        emit IKuruOrderBook.Trade(2, mm, true, 3_640_000 * 1e12, uint96(15_000), taker, tx.origin, uint96(5_000));
        vm.prank(taker);
        m.placeAndExecuteMarketBuy(uint96(3_640_000 * 3 / 2), 1, false, false);
        (uint256 bid, uint256 ask) = m.bestBidAsk();
        assertEq(bid, 0);
        assertEq(ask, 3_640_000 * 1e12);
    }

    // ------------------------------------------------------------------ differential: the model's own numbers

    struct V {
        uint256 tf;
        uint256 mf;
        uint256 qin;
        uint256 got;
        uint256 spent;
        uint256 sellUnits;
        uint256 sellOut;
        uint256 baseSold;
        uint256 mmQuote;
        uint256 mmBase;
    }

    /// 32 random books (1 to 5 levels a side, one or two orders per placement, fees 0, 30 or 100 bps), a random
    /// non-fill-or-kill buy and sell on each: every amount equals the model's to the base unit, makers included.
    function test_differential_modelVectors() public {
        for (uint256 i; i < 32; ++i) {
            uint256[] memory w = abi.decode(_vector(i), (uint256[]));
            V memory v = V(w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9]);
            NoPermitDollar b = new NoPermitDollar("b", "B");
            NoPermitDollar q = new NoPermitDollar("q", "Q");
            base = b;
            quote = q;
            MockKuruOrderBook mk = _market(v.tf, v.mf);
            for (uint256 j; j < w[10]; ++j) {
                uint256 o = w[11 + j];
                vm.prank(mm);
                if (o >> 160 == 1) mk.addSellOrder(uint32(o >> 96), uint96(o), false);
                else mk.addBuyOrder(uint32(o >> 96), uint96(o), false);
            }
            (uint256 sim,) = mk.simulateBuy(v.qin);
            assertEq(sim, v.got, "simulate");
            uint256 q0 = q.balanceOf(taker);
            uint256 b0 = b.balanceOf(taker);
            vm.prank(taker);
            assertEq(mk.placeAndExecuteMarketBuy(uint96(v.qin), 0, false, false), v.got, "buy");
            assertEq(b.balanceOf(taker) - b0, v.got, "tokens");
            assertEq(q0 - q.balanceOf(taker), v.spent, "spent");
            q0 = q.balanceOf(taker);
            b0 = b.balanceOf(taker);
            vm.prank(taker);
            assertEq(mk.placeAndExecuteMarketSell(uint96(v.sellUnits), 0, false, false), v.sellOut, "sell");
            assertEq(q.balanceOf(taker) - q0, v.sellOut, "sell out");
            assertEq(b0 - b.balanceOf(taker), v.baseSold, "base sold");
            assertEq(q.balanceOf(mm), v.mmQuote, "maker quote");
            assertEq(b.balanceOf(mm), v.mmBase, "maker base");
        }
    }

