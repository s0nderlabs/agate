{
  "name": "agate-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.capture.json",
    "gen:abis": "bun run scripts/gen-abis.ts",
    "gen:config": "bun run scripts/gen-config.ts",
    "gen:testnet": "bun run scripts/gen-testnet.ts",
    "capture": "bun run scripts/capture-local.ts"
  },
  "dependencies": {
    "envio": "3.12.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "viem": "2.57.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "express": "4.22.3",
      "body-parser": "1.20.6",
      "path-to-regexp": "0.1.13",
      "qs": "6.16.0",
      "cookie": "0.7.2",
      "send": "0.19.2",
      "serve-static": "1.16.3",
      "ws": "8.22.0",
      "esbuild": "0.28.2"
    }
  },
  "overrides": {
