# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Public address of the agent's session key. The app grants this address in step 4.
# The operator creates the key themselves, in their own terminal.
VITE_AGENT_ADDRESS=

# Private key of that same session key, read only by agent/run.ts. Testnet-only, holds no funds
# (the ZeroDev paymaster sponsors its user operations).
AGENT_SESSION_PRIVATE_KEY=

# Optional: where agent/run.ts reads the grant downloaded from step 4 (default agent/grant.json).
AGENT_GRANT_FILE=

# Optional: Monad testnet RPC for reads in agent/run.ts (default https://testnet-rpc.monad.xyz).
MONAD_RPC_URL=

# Optional fallback if shared/ids.json is missing dynamicEnvironmentId (client-side id, not a secret).
VITE_DYNAMIC_ENVIRONMENT_ID=

# Dashboard ids (dynamicEnvironmentId, zerodevProjectId, zerodevBundlerRpc, zerodevPaymasterRpc) are read
# from ../shared/ids.json, not from this file.
