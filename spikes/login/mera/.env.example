# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# --- drip server (bun run drip) ---
# Funding key for the 0.2 MON drip. Monad testnet only. The operator enters it; read at run time, never logged.
DRIP_PRIVATE_KEY=
# Optional: defaults shown
DRIP_RPC_URL=https://testnet-rpc.monad.xyz
DRIP_PORT=5181
DRIP_AMOUNT_MON=0.2
DRIP_MAX_COUNT=50

# --- agent (bun run agent <userAddress>) ---
# The agent's own key. It needs a little testnet MON for gas (drip it: curl -XPOST localhost:5181/drip -d '{"address":"0xAgent"}').
AGENT_PRIVATE_KEY=
# Optional: the user to buy for (or pass it as the first argument)
USER_ADDRESS=
RPC_URL=https://testnet-rpc.monad.xyz

# --- app (bun run dev), public values only ---
# The agent's ADDRESS (not its key): bun agent/run.ts --address
VITE_AGENT_ADDRESS=
VITE_RPC_URL=https://testnet-rpc.monad.xyz
VITE_SESSION_MINUTES=30
