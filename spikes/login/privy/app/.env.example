# All optional. Client-side ids only, never secrets. Copy to .env.local to override.
# Default source for the app id: ../../shared/ids.json ("privyAppId").
VITE_PRIVY_APP_ID=
# Optional app client id (dashboard > App settings > Clients). Leave empty to use the default client.
VITE_PRIVY_CLIENT_ID=
# Default source for these two: ../agent/policy.json, written by `bun run policy` in ../agent.
# Signer id = the key quorum id shown next to the authorization key in the dashboard.
VITE_PRIVY_SIGNER_ID=
VITE_PRIVY_AGENT_POLICY_ID=
