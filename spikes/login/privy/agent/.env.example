# Copy to agent/.env.local (gitignored) and fill in. Bun loads .env.local automatically.
# All values come from dashboard.privy.io for the agate spike app. Never commit or paste these anywhere.

# App id (not secret). Optional here: falls back to privyAppId in spikes/login/shared/ids.json.
PRIVY_APP_ID=
# SECRET. Dashboard > App settings > Basics > App secret.
PRIVY_APP_SECRET=
# SECRET. Dashboard > Authorization keys > New key. Paste the private key exactly as shown (starts with "wallet-auth:").
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Not secret. The id shown next to that authorization key (the key quorum id the user adds as a signer).
PRIVY_SIGNER_ID=
