.env
.env.*
!.env.example
*.key
credentials.json
secrets.yaml
project.yaml
# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/
# a deploy run's plan until DeployMarket verify() finds every address on chain; test files, as a backstop
contracts/deployments/*.pending
contracts/deployments/.test-*
# ops/testnet: the configs a run renders for itself and the fork rehearsal's records (removed after each run)
contracts/script/config/kit-fork-*.json
contracts/script/config/market-kit-*.json
contracts/deployments/fork-kit-*
out/
cache/
broadcast/
# bun / node
node_modules/
# CRE build output (the workflow compiles to JS + WASM locally)
wall/apps/writer-cre/workflow/dist/
wall/apps/writer-cre/workflow/.cre_build_tmp.js
*.wasm
# local data of the wall roles (logs, raw pages, alerts); the default home is ~/.agate-wall, outside the repo
.agate-wall/
wall/**/data/
wall/e2e/out/
*.log
# third-party raw pages are never committed (read from AGATE_RAW_DIR)
raw/
# ...but the app's route folder that serves the docs as markdown (/docs/raw/<slug>.md) is code, not a page
!/app/src/app/docs/raw/
*.html.gz
*.all.gz
# OS
.DS_Store
# python
__pycache__/
*.pyc
# build specs, the spec's reference model and the login experiments stay local
docs/wall/BUILD-SPEC.md
docs/market/BUILD-SPEC.md
docs/market/BOTS-SPEC.md
docs/market/model/
docs/private/
spikes/
.vercel
.env*.local

